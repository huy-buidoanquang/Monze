<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Consume the published SDK so runtime and tests exercise the release artifact. -->
    <UseLocalMezonSdk>false</UseLocalMezonSdk>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Monze.Application\Monze.Application.csproj" />
    <PackageReference Include="Mezon.Net.Sdk" Version="1.6.0" />
    <PackageReference Include="Mezon.Net.Sdk.Caching.Redis" Version="1.6.0" />
    <PackageReference Include="Mezon.Net.Sdk.Caching.Sqlite" Version="1.6.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.31" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Persistence\Migrations\*.sql" />
    <InternalsVisibleTo Include="Monze.Tests" />
    <InternalsVisibleTo Include="Monze.Benchmarks" />
  </ItemGroup>
</Project>
