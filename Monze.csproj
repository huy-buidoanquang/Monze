<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Consume the published SDK so runtime and tests exercise the release artifact. -->
    <UseLocalMezonSdk>false</UseLocalMezonSdk>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Monze.Domain/**;Monze.Application/**;Monze.Infrastructure/**;Monze.Tests/**;Monze.Benchmarks/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="appsettings.json" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Monze.Infrastructure\Monze.Infrastructure.csproj" />
    <PackageReference Include="Mezon.Net.Sdk" Version="1.6.1" />
    <PackageReference Include="Mezon.Net.Sdk.Caching.Redis" Version="1.6.1" />
    <PackageReference Include="Mezon.Net.Sdk.Caching.Sqlite" Version="1.6.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Monze.Tests" />
    <InternalsVisibleTo Include="Monze.Benchmarks" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.Development.local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
